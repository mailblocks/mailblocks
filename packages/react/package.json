    "keywords": [
        "react",
        "email",
        "email-builder",
        "email-editor",
        "caniemail"
    ],
    "author": {
        "name": "Ibrahim Mohamed",
        "url": "https://github.com/ibrahimmohamed4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mailblocks/mailblocks.git",
        "directory": "packages/react"
    },
    "homepage": "https://github.com/mailblocks/mailblocks#readme",
    "bugs": "https://github.com/mailblocks/mailblocks/issues",
